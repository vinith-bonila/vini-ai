# ─── VINI AI configuration ───────────────────────────────────────────
# Copy to `.env` and fill in. Everything has a safe default; the app runs
# with structured skills even when no OpenAI key is set.

# LLM (enables general conversation, hosted Whisper STT, and OpenAI TTS)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1

# NLP
SPACY_MODEL=en_core_web_sm
USE_EMBEDDINGS=false               # true -> sentence-transformers intent model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
USE_HF_SENTIMENT=false             # true -> transformer sentiment model
INTENT_CONFIDENCE_FLOOR=0.28

# Speech
STT_BACKEND=openai                 # openai | local
TTS_BACKEND=gtts                   # gtts | openai | pyttsx3
DEFAULT_TTS_LANGUAGE=en
VOICE_SPEED=1.0

# Skills
ALLOW_LOCAL_SYSTEM_SKILLS=false    # true only when running on your own machine
WEATHER_DEFAULT_CITY=Visakhapatnam
NEWS_API_KEY=

# System
DB_PATH=data/vini_ai.db
LOG_LEVEL=INFO
