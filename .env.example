# ─── VINI AI configuration ───────────────────────────────────────────
# Copy to `.env` and add your key. Everything has a safe default; the app
# runs with structured skills even when no key is set.
#
# Default provider: Groq - free tier, and the fastest inference available
# without self-hosting, which is what keeps the voice loop feeling live.
# Get a key at https://console.groq.com/keys

# LLM (enables general conversation and hosted Whisper STT)
OPENAI_API_KEY=

# The endpoint every OpenAI-compatible call goes to. This MUST match the key:
# a Groq key sent to api.openai.com returns 401, which surfaces in the UI as
# "my language model is unreachable".
# Leaving this blank does NOT mean OpenAI - blank falls back to the Groq
# default below, so switching providers means setting it explicitly.
#   Groq (default): https://api.groq.com/openai/v1
#   OpenAI:         https://api.openai.com/v1
#   Together:       https://api.together.xyz/v1
#   Ollama (local): http://localhost:11434/v1
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Models must be ones the provider above actually serves. These match the
# built-in defaults, so a fresh install with no .env behaves identically.
#   Groq chat  : openai/gpt-oss-20b, llama-3.3-70b-versatile
#   Groq STT   : whisper-large-v3   (whisper-1 is OpenAI-only)
#   OpenAI     : gpt-4o-mini / whisper-1
OPENAI_CHAT_MODEL=openai/gpt-oss-20b
OPENAI_STT_MODEL=whisper-large-v3

# Only used when TTS_BACKEND=openai. Groq does not serve these, so the
# default gTTS backend below is the right pairing for Groq.
OPENAI_TTS_MODEL=tts-1

# NLP
SPACY_MODEL=en_core_web_sm
USE_EMBEDDINGS=false               # true -> sentence-transformers intent model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
USE_HF_SENTIMENT=false             # true -> transformer sentiment model
INTENT_CONFIDENCE_FLOOR=0.28

# Speech
STT_BACKEND=openai                 # openai (hosted Whisper) | local
TTS_BACKEND=edge                   # edge | gtts | openai | pyttsx3

# Voice for the "edge" backend (free Microsoft neural voices, no API key).
#   en-IN-NeerjaNeural   Indian English, female  (default)
#   en-IN-PrabhatNeural  Indian English, male
#   en-US-AriaNeural     US English, female
#   en-GB-SoniaNeural    UK English, female
EDGE_VOICE=en-IN-NeerjaNeural

# Proper nouns Whisper otherwise mishears ("Visakhapatnam" -> "Vietnam").
# Add names you use often; it biases decoding rather than restricting it.
STT_VOCABULARY=
DEFAULT_TTS_LANGUAGE=en
VOICE_SPEED=1.0

# Skills
ALLOW_LOCAL_SYSTEM_SKILLS=false    # true only when running on your own machine
WEATHER_DEFAULT_CITY=Visakhapatnam
NEWS_API_KEY=

# System
DB_PATH=data/vini_ai.db
LOG_LEVEL=INFO
